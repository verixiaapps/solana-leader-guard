# /etc/leader-guard.env — leader-guard configuration
LEADER_GUARD_IDENT=YourVoteOrIdentityPubkeyHere
LEADER_GUARD_VALIDATOR_UNIT=sfdp-validator.service
LEADER_GUARD_VALIDATOR_PROC=agave-validator
LEADER_GUARD_RPC=http://localhost:8899

# Public feed used ONLY for post-window production accounting
LEADER_GUARD_PUB_RPC=https://api.testnet.solana.com

# Competing work: stopped entirely during leader windows, restored after
LEADER_GUARD_CONFLICT_UNITS=""
# IO-choked (not stopped) during leader windows
LEADER_GUARD_CHOKE_UNITS=""
LEADER_GUARD_CHOKE_CONTAINERS=""
# Per-unit baseline for unchoke: "unit:readmax:writemax unit2:..."
LEADER_GUARD_CHOKE_BASE=""

LEADER_GUARD_CHOKE_DEV=/dev/nvme0n1
LEADER_GUARD_BOOST_SLOTS=6000
LEADER_GUARD_CHOKE_SLOTS=150
LEADER_GUARD_EPOCH_PROTECT_SLOTS=3000

# Alert webhook — POST {"message":"..."} on confirmed misses
LEADER_GUARD_ALERT_URL=
LEADER_GUARD_ALERT_KEY=
LEADER_GUARD_ALERT_BOX=validator-1
